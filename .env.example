APP_NAME=AUTOMETRIA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL (CI: lastik_test / lastik / secret @ 127.0.0.1)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lastik
DB_USERNAME=lastik
DB_PASSWORD=secret

# F2: жёсткая проверка DB-роли (NOBYPASSRLS) при миграциях.
# false в CI/локально (контейнер-postgres = superuser).
# true на проде после роли lastik_app.
DB_ROLE_ENFORCE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
MAIL_MAILER=log
BROADCAST_CONNECTION=null

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Demo stand (Hermes): POST /api/v1/demo/login
DEMO_MODE=false

# Block 3.3 — Честный Знак / маркировка (mock by default)
MARKING_MOCK_MODE=true

# Vue / Vite bridge (optional)
# VITE_API_BASE_URL=/api/v1
# VITE_LARAVEL_PROXY=http://127.0.0.1:8010

GEMINI_API_KEY=
