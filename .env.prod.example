# Client-side deploy secrets (НЕ коммитить реальные значения)
# Alias of .env.production.example — used by:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod …
#
# See also: .env.production.example and docs/DEPLOYMENT_RUNBOOK.md

APP_NAME="AUTOMETRIA ERP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://erp.client.example
HTTP_PORT=80

DB_DATABASE=autometria_prod
DB_USERNAME=autometria_user
DB_PASSWORD=change-me-strong-db-password

REDIS_PASSWORD=change-me-strong-redis-password
