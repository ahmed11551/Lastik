# AUTOMETRIA ERP — production env template
# Copy to .env.prod (Compose) or .env.production on the host:
#   cp .env.production.example .env.prod
#
# DO NOT commit real secrets.

APP_NAME="AUTOMETRIA ERP"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://erp.client.example

# Host-facing HTTP port for the nginx service in docker-compose.prod.yml
HTTP_PORT=80

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=autometria_prod
DB_USERNAME=autometria_user
DB_PASSWORD=change-me-strong-db-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_CLIENT=predis

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Optional: 1C / CommerceML Basic Auth defaults (overridable per-tenant in UI)
# ONE_C_LOGIN=
# ONE_C_PASSWORD=
